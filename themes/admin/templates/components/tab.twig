<button type="button"
        role="tab"
        id="admin-tab-{{ id }}"
        class="admin-tab{% if active %} is-active{% endif %}"
        data-tab="{{ id }}"
        aria-controls="admin-tab-panel-{{ id }}"
        aria-selected="{{ active ? 'true' : 'false' }}"
        tabindex="{{ active ? '0' : '-1' }}">
    {{ label }}
    {% if badge|default(0) > 0 %}
        <span class="admin-tab-badge"
              title="{{ badgeTitle|default('') }}"
              aria-label="{{ badgeTitle|default('') }}">
            {{ badge > 99 ? '99+' : badge }}
        </span>
    {% endif %}
    <span class="admin-tab-dirty" hidden title="{{ t('admin.tabs.unsaved') }}"></span>
</button>
