{% set brand = site_title is defined and site_title != '' ? site_title : t('app.name') %}
{% set tagline = footer_text is defined and footer_text != '' ? footer_text : t('theme.kingdoms.footer_tagline') %}
<footer class="k-footer hj-footer">
    <svg class="hj-footer-ridge" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
        <path class="hj-ridge-far" d="M0 120V70c90-22 150-48 230-36 70 10 110-30 190-34 90-4 130 44 220 40 80-4 130-50 220-46 100 4 150 46 250 40 90-6 150-34 240-26 50 4 70 14 90 20v62Z"/>
        <path class="hj-ridge-near" d="M0 120V96c110-8 190-34 300-24 120 12 180 34 300 26 130-8 190-40 320-34 120 6 190 32 300 30 90-2 150-14 220-18v44Z"/>
    </svg>
    <div class="hj-footer-inner">
        <span class="hj-footer-seal" aria-hidden="true">石</span>
        <p class="hj-footer-brand">{{ brand }}</p>
        {% if tagline != '' %}
            <p class="hj-footer-tagline">{{ tagline }}</p>
        {% endif %}
        <ul class="hj-footer-realms" aria-hidden="true">
            {% for empire in [1, 2, 3] %}
                <li class="hj-realm-{{ empire }}">{{ t('theme.hanji.kingdom_name_' ~ empire) }}</li>
            {% endfor %}
        </ul>
        {% if social_links is defined and social_links is not empty %}
            <ul class="k-social" aria-label="{{ t('theme.kingdoms.social_links') }}">
                {% for network, url in social_links %}
                    <li>
                        <a href="{{ url }}"
                           class="k-social-link"
                           target="_blank"
                           rel="noopener noreferrer"
                           title="{{ t('nav.social_' ~ network) }}"
                           aria-label="{{ t('nav.social_' ~ network) }}">
                            {% include 'components/social-icon.twig' with { network: network } %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <p class="hj-footer-credit">
            <a href="https://github.com/dev-brunoreis/metin2-website"
               target="_blank"
               rel="noopener noreferrer">{{ t('theme.kingdoms.cms_credit') }}</a>
        </p>
    </div>
</footer>
